  <property name="styleSheet">
   <string notr="true">/*=====主窗口全局纯白色背景=====*/
QMainWindow {
background-color: #ffffff;
}
QWidget#centralwidget {
background-color: #ffffff;
}

/*=====所有Label文字=====*/
QLabel {
color: #2d3748;
background-color: transparent;
}

/* 指定label全部强制透明背景 */
QLabel#label,
QLabel#label_6,
QLabel#label_dianchi,
QLabel#label_3,
QLabel#label_chesu,
QLabel#label_logo,
QLabel#label_img
{
background-color: transparent;
}

/*=====QFrame 卡片（车门锁组件卡片）浅灰卡片 + hover悬浮特效=====*/
QFrame {
background-color: #f5f7fa;
border-radius: 14px;
border: 1px solid #edf2f7;
}
QFrame:hover{
    background-color:#f0f3f8;
}

/*=====复选框CheckBox美化 + hover特效=====*/
QCheckBox {
color: #2d3748;
spacing: 10px;
}
QCheckBox::indicator {
width: 22px;
height: 22px;
border-radius: 6px;
border: 2px solid #cbd5e0;
background-color: #ffffff;
}
/*鼠标悬浮复选框方框*/
QCheckBox::indicator:hover{
    border-color:#79b3ff;
}
QCheckBox::indicator:checked {
background-color: #5a9eff; /*柔和亮蓝*/
border-color: #5a9eff;
}
QCheckBox::indicator:checked:hover{
    background-color:#4488ee;
}
QCheckBox::indicator:disabled {
border-color: #e2e8f0;
background-color: #f7fafc;
}

/*=====SpinBox温度调节控件【修复箭头+hover+focus焦点特效】=====*/
QSpinBox {
background-color: #ffffff;
border: 1px solid #e2e8f0;
border-radius: 8px;
color: #2d3748;
padding: 6px 8px;
}
/*鼠标悬浮输入框：边框变蓝*/
QSpinBox:hover{
    border:1px solid #94bfff;
}
/*获得输入焦点，高亮边框，车机交互感*/
QSpinBox:focus{
    border:1px solid #5a9eff;
}

/* 上下按钮容器 */
QSpinBox::up-button, QSpinBox::down-button {
width:26px;
background-color:#f5f7fa;
border:none;
}
QSpinBox::up-button:hover {
background-color:#e1e7ef;
}
QSpinBox::down-button:hover {
background-color:#e1e7ef;
}
QSpinBox::up-button:pressed {
background-color:#cbd5e0;
}
QSpinBox::down-button:pressed {
background-color:#cbd5e0;
}

/* 绘制箭头三角（靠背景色做三角，不用图片） */
QSpinBox::up-arrow {
width: 0px;
height: 0px;
border-left:6px solid transparent;
border-right:6px solid transparent;
border-bottom:8px solid #4a5568;
}
QSpinBox::down-arrow {
width: 0px;
height: 0px;
border-left:6px solid transparent;
border-right:6px solid transparent;
border-top:8px solid #4a5568;
}

/*=====布局内widget容器 浅灰卡片 + hover悬浮特效=====*/
QWidget#widget {
background-color: #f5f7fa;
border-radius: 14px;
border: 1px solid #edf2f7;
}
QWidget#widget:hover{
    background-color:#f0f3f8;
}
</string>
